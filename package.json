    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
