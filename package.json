{
  "name": "bayi-teknik-destek-backend",
  "version": "0.1.0",
  "description": "Yangin & Kamera Bayi Teknik Destek - Backend (NestJS + Prisma + pgvector)",
  "private": true,
  "scripts": {
    "build": "nest build",
