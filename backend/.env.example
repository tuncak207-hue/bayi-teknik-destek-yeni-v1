# ---- Veritabanı ----
# Local örneği. Supabase kullanırken Dashboard > Connect bölümünden alınan
# PostgreSQL bağlantı string’ini kullanın; production’da SSL zorunludur.
# Supabase runtime için transaction pooler (6543) kullanın.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma migration için session pooler (5432) kullanın.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Supabase project URL’si API_BASE_URL değildir. Flutter/admin için NestJS
# backend’in public adresi ayrıca MOBILE_API_BASE_URL olarak tanımlanır.
# MOBILE_API_BASE_URL="https://<public-backend-domain>/api/v1"

# ---- Auth ----
JWT_SECRET="degistirin-cok-guclu-bir-secret-yazin"
# Google ile giriş için: Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client ID (Web application) -> Client ID değeri
GOOGLE_CLIENT_ID=""

# ---- AI sağlayıcısı ----
# anthropic | groq | ollama | manus
AI_PROVIDER="anthropic"

# ---- AI (Anthropic Claude) ----
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-6"

# ---- AI (Manus ajan API) ----
# AI_PROVIDER="manus" olduğunda zorunludur.
MANUS_API_KEY=""
MANUS_API_BASE_URL="https://api.manus.ai"
MANUS_AGENT_PROFILE="standard"
MANUS_LOCALE="tr"
MANUS_TIMEOUT_MS="120000"
MANUS_POLL_INTERVAL_MS="2000"

# ---- Embedding (RAG için - Voyage AI veya OpenAI) ----
EMBEDDING_PROVIDER="voyage"   # "voyage" | "openai"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="voyage-3"

# ---- Depolama (S3 uyumlu: AWS S3, Cloudflare R2, MinIO, vb.) ----
STORAGE_ENDPOINT="https://<endpoint>"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="bayi-teknik-destek"

# ---- Firebase Cloud Messaging (push bildirimleri) ----
# Firebase service-account JSON dosyasının TEK SATIR JSON string hali
FIREBASE_CONFIG=""

# ---- Sunucu ----
PORT=3000
